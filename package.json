{
  "name": "jojo-friends",
  "version": "0.1.0",
  "private": true,
  "description": "Jojo & Friends: Joye's personal character IP — 26 characters with 16 emotions and 6 statuses each, and the public showcase site (downloads and source are private).",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tsx scripts/site-public-assets.tsx && vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsx scripts/site-public-assets.tsx && tsc --noEmit -p tsconfig.json && vite build && tsx scripts/check-public-dist.ts dist",
    "check:public": "tsx scripts/check-public-dist.ts dist",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "preview": "vite preview --host 127.0.0.1",
    "dev:town": "vite --config vite.town.config.ts",
    "build:town": "tsc --noEmit -p tsconfig.json && vite build --config vite.town.config.ts",
    "preview:town": "vite preview --config vite.town.config.ts --host 127.0.0.1",
    "sheets": "tsx scripts/character-sheet.tsx",
    "identity": "tsx scripts/ref/identity.tsx",
    "solve": "tsx scripts/gen-solved.ts",
    "manifest": "tsx scripts/gen-manifest.ts",
    "export:private": "tsx scripts/export-private-kit.tsx"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.1",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "sideEffects": [
    "*.css",
    "./src/site/main.tsx"
  ]
}
