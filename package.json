{
  "name": "jojo-friends",
  "version": "0.1.0",
  "private": true,
  "description": "Jojo 的小家 (Jojo House): Jojo's home — stories, friends, and the Jojo & Friends character family (26 characters, 16 emotions, 6 statuses). Public site is a showcase; downloads and source are private.",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tsx scripts/site-public-assets.tsx && vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsx scripts/site-public-assets.tsx && tsc --noEmit -p tsconfig.json && vite build && vite build --ssr src/site/entry-server.tsx --outDir .ssr --emptyOutDir && tsx scripts/prerender.ts dist .ssr && tsx scripts/check-public-dist.ts dist",
    "check:public": "tsx scripts/check-public-dist.ts dist",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "preview": "vite preview --host 127.0.0.1",
    "sheets": "tsx scripts/character-sheet.tsx",
    "identity": "tsx scripts/ref/identity.tsx",
    "solve": "tsx scripts/gen-solved.ts",
    "manifest": "tsx scripts/gen-manifest.ts",
    "export:private": "tsx scripts/export-private-kit.tsx",
    "avatars": "tsx scripts/avatar-standard.tsx",
    "serve:dist": "tsx scripts/serve-dist.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.1",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "sideEffects": [
    "*.css",
    "./src/site/main.tsx"
  ]
}
